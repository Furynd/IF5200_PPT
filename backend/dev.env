# PostgreSQL (Transactional Data & pg_trgm)
POSTGRES_USER=referly_admin
POSTGRES_PASSWORD=referly_secure_123
POSTGRES_DB=referly_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# DB_MODE options:
# - auto: prefer DATABASE_URL, then SUPABASE_DATABASE_URL, then local fallback
# - supabase: force SUPABASE_DATABASE_URL (or DATABASE_URL)
# - local: force local POSTGRES_* URL
DB_MODE=local

# Optional explicit URLs
DATABASE_URL=
SUPABASE_DATABASE_URL=

# Example Supabase URL:
# SUPABASE_DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

SUPABASE_JWT_SECRET=super_secret

# Neo4j (Graph Data)
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_graph_456
NEO4J_URI=bolt://neo4j:7687

# Redis (Ghost Hashes & Rate Limiting)
REDIS_URL=redis://redis:6379/0